<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net6.0</TargetFramework>
    <AssemblyName>SonarEasyMode</AssemblyName>
    <RootNamespace>SonarEasyMode</RootNamespace>
    <Version>0.1.0</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>disable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <CopyLocalLockFileAssemblies>false</CopyLocalLockFileAssemblies>
    <!-- No default on purpose (keeps local paths out of the repo). Pass -p:GameDir="X:\path\to\SONAR",
         set a GameDir environment variable, or build via the Makefile (reads local.mk). -->
    <BepInExDir>$(GameDir)\BepInEx</BepInExDir>
  </PropertyGroup>

  <Target Name="CheckGameDir" BeforeTargets="ResolveAssemblyReferences;Build">
    <Error Condition="'$(GameDir)' == ''" Text="GameDir is not set. Use -p:GameDir=&quot;X:\path\to\SONAR&quot;, a GameDir environment variable, or the Makefile with local.mk." />
    <Error Condition="!Exists('$(BepInExDir)\interop\Assembly-CSharp.dll')" Text="BepInEx interop not found in $(BepInExDir). Install BepInEx and launch the game once." />
  </Target>

  <ItemGroup>
    <Reference Include="$(BepInExDir)\core\BepInEx.Core.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.IL2CPP.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\BepInEx.Unity.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\0Harmony.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Runtime.dll" Private="false" />
    <Reference Include="$(BepInExDir)\core\Il2CppInterop.Common.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Il2Cppmscorlib.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.CoreModule.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\UnityEngine.dll" Private="false" />
    <Reference Include="$(BepInExDir)\interop\Assembly-CSharp.dll" Private="false" />
  </ItemGroup>

  <Target Name="DeployToGame" AfterTargets="Build" Condition="'$(Deploy)' != 'false'">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(BepInExDir)\plugins\SonarEasyMode" />
    <Message Importance="high" Text="Deployed $(TargetFileName) to $(BepInExDir)\plugins\SonarEasyMode" />
  </Target>

</Project>
